---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Motif from './Motif.astro';
import AmenityIcon from './AmenityIcon.astro';
import logoMark from '../assets/brand/logo-mark.svg';
import { apartments, homeHero, mapImage, mapsUrl, storyPhotos } from '../data/apartments';
import {
  useTranslations,
  localePath,
  bookingUrls,
  contactEmail,
  type Locale,
} from '../i18n/translations';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const amenityIcons = ['wifi', 'ac', 'balcony', 'coffee', 'dishwasher', 'oven', 'desk', 'bathroom'] as const;
---

<Base locale={locale} path="/">
  <main>
    <!-- Hero: ink canvas, logo left, photo bleeding off the right edge -->
    <section class="relative min-h-svh overflow-hidden bg-ink text-cream">
      <div class="absolute inset-y-0 right-0 w-full overflow-hidden md:w-[54%]">
        <Image
          src={homeHero}
          alt=""
          class="h-full w-full object-cover opacity-90"
          data-kenburns
          widths={[640, 1024, 1440, 1920]}
          sizes="(max-width: 768px) 100vw, 54vw"
          loading="eager"
          fetchpriority="high"
        />
        <div class="absolute inset-0 bg-gradient-to-r from-ink via-ink/55 to-ink/10 md:via-ink/25"></div>
        <div class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-ink to-transparent md:hidden"></div>
      </div>

      <div class="relative mx-auto flex min-h-svh max-w-7xl flex-col justify-end px-5 pb-20 pt-32 sm:px-8 md:justify-center md:pb-28">
        <p class="label mb-8 text-gold/90" data-hero-item>{t.hero.kicker}</p>
        <img
          src={logoMark.src}
          alt={`AmoreMore Apartments - ${t.hero.tagline}`}
          class="w-full max-w-xl md:max-w-2xl"
          fetchpriority="high"
          data-hero-item
        />
        <p class="mt-10 max-w-md font-display text-2xl font-light italic leading-snug text-cream/85 md:text-3xl" data-hero-item>
          {t.hero.tagline}
        </p>
        <div class="mt-12 flex flex-wrap items-center gap-6" data-hero-item>
          <a
            href="#contact"
            class="label border border-gold px-7 py-3.5 text-gold transition-colors duration-300 hover:bg-gold hover:text-ink"
          >{t.nav.book}</a>
          <a href="#apartments" class="label group inline-flex items-center gap-3 text-cream/70 transition-colors hover:text-cream">
            {t.apartments.kicker}
            <span class="block h-px w-10 bg-cream/40 transition-all duration-300 group-hover:w-16 group-hover:bg-gold"></span>
          </a>
        </div>
      </div>

      <a href="#story" class="label absolute bottom-6 left-1/2 hidden -translate-x-1/2 text-cream/50 md:block" data-scroll-hint>
        {t.hero.scroll} ↓
      </a>
    </section>

    <!-- Story: editorial split with overlapping plaque photos -->
    <section id="story" class="px-5 py-24 sm:px-8 md:py-36">
      <div class="mx-auto grid max-w-7xl items-center gap-14 md:grid-cols-12">
        <div class="gs-reveal md:col-span-5" data-reveal>
          <p class="label text-rose-deep">{t.story.kicker}</p>
          <span class="rule my-6"></span>
          <h2 class="font-display text-4xl font-medium leading-[1.05] md:text-6xl">{t.story.title}</h2>
          <p class="mt-8 text-lg leading-relaxed text-charcoal/80">{t.story.p1}</p>
          <p class="mt-4 text-lg leading-relaxed text-charcoal/80">{t.story.p2}</p>
        </div>
        <div class="relative md:col-span-7 md:pl-10">
          <div class="gs-reveal relative z-10 w-[72%] overflow-hidden" data-reveal>
            <Image
              src={storyPhotos.back}
              alt={`${t.apartments.amore.name} - ${t.apartments.amore.type}`}
              widths={[480, 800, 1200]}
              sizes="(max-width: 768px) 72vw, 38vw"
              class="h-auto w-full object-cover"
              data-parallax="8"
            />
          </div>
          <div class="gs-reveal relative z-20 -mt-[30%] ml-auto w-[62%] overflow-hidden border-8 border-cream shadow-2xl" data-reveal>
            <Image
              src={storyPhotos.front}
              alt={`${t.apartments.more.name} - ${t.apartments.more.type}`}
              widths={[480, 800, 1200]}
              sizes="(max-width: 768px) 62vw, 33vw"
              class="h-auto w-full object-cover"
              data-parallax="-6"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Apartments: two asymmetric editorial cards -->
    <section id="apartments" class="bg-cream-deep px-5 py-24 sm:px-8 md:py-36">
      <div class="mx-auto max-w-7xl">
        <div class="gs-reveal max-w-xl" data-reveal>
          <p class="label text-rose-deep">{t.apartments.kicker}</p>
          <span class="rule my-6"></span>
          <h2 class="font-display text-4xl font-medium leading-[1.05] md:text-6xl">{t.apartments.title}</h2>
        </div>

        <div class="mt-16 grid gap-14 md:grid-cols-2 md:gap-10">
          {(['amore', 'more'] as const).map((id, i) => {
            const apt = apartments[id];
            const copy = t.apartments[id];
            return (
              <a
                href={localePath(locale, `/${id}/`)}
                class:list={['gs-reveal group block', i === 1 && 'md:mt-24']}
                data-reveal
              >
                <div class="relative overflow-hidden">
                  <Image
                    src={apt.card}
                    alt={`${copy.name} - ${copy.type}`}
                    widths={[480, 800, 1200]}
                    sizes="(max-width: 768px) 92vw, 45vw"
                    class="aspect-[4/3] w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.05]"
                  />
                  <div class="absolute inset-0 bg-ink/0 transition-colors duration-500 group-hover:bg-ink/15"></div>
                  <Motif kind={apt.motif} class="absolute right-5 top-5 h-9 w-auto text-cream drop-shadow" />
                </div>
                <div class="mt-7 flex items-start justify-between gap-6">
                  <div>
                    <h3 class="font-display text-4xl font-medium italic md:text-5xl">{copy.name}</h3>
                    <p class="label mt-3 text-charcoal/60">{copy.type} · {copy.sleeps}</p>
                    <p class="mt-4 max-w-md leading-relaxed text-charcoal/75">{copy.blurb}</p>
                  </div>
                  <span class="label mt-3 inline-flex shrink-0 items-center gap-3 text-rose-deep">
                    {t.apartments.explore}
                    <span class="block h-px w-8 bg-rose-deep transition-all duration-300 group-hover:w-14"></span>
                  </span>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </section>

    <!-- Amenities: dark band, gold icons -->
    <section class="bg-ink px-5 py-24 text-cream sm:px-8 md:py-32">
      <div class="mx-auto max-w-7xl">
        <div class="gs-reveal max-w-xl" data-reveal>
          <p class="label text-gold">{t.amenities.kicker}</p>
          <span class="rule my-6"></span>
          <h2 class="font-display text-4xl font-medium leading-[1.05] md:text-5xl">{t.amenities.title}</h2>
        </div>
        <ul class="mt-16 grid grid-cols-2 gap-x-8 gap-y-12 sm:grid-cols-3 lg:grid-cols-4" data-stagger>
          {amenityIcons.map((name) => (
            <li class="gs-reveal flex flex-col gap-4">
              <AmenityIcon name={name} class="h-9 w-9 text-gold" />
              <span class="text-sm text-cream/80">{t.amenities.items[name]}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Location: oversized numerals -->
    <section id="location" class="px-5 py-24 sm:px-8 md:py-36">
      <div class="mx-auto max-w-7xl">
        <div class="grid gap-14 md:grid-cols-12">
          <div class="gs-reveal md:col-span-5" data-reveal>
            <p class="label text-rose-deep">{t.location.kicker}</p>
            <span class="rule my-6"></span>
            <h2 class="font-display text-4xl font-medium leading-[1.05] md:text-6xl">{t.location.title}</h2>
            <p class="mt-8 max-w-md text-lg leading-relaxed text-charcoal/80">{t.location.body}</p>
            <a href={mapsUrl} target="_blank" rel="noopener" class="label group mt-10 inline-flex items-center gap-3 text-rose-deep">
              {t.location.mapLink}
              <span class="block h-px w-8 bg-rose-deep transition-all duration-300 group-hover:w-14"></span>
            </a>
          </div>
          <div class="md:col-span-7">
            <dl class="divide-y divide-charcoal/15" data-stagger>
              {([
                ['7', t.location.walkToBeach],
                ['1', t.location.toPalace],
                ['23', t.location.toAirport],
              ] as const).map(([num, label]) => (
                <div class="gs-reveal flex items-baseline gap-8 py-8">
                  <dt class="font-display text-7xl font-light text-rose-deep md:text-8xl" data-count={num}>{num}</dt>
                  <dd class="label max-w-xs text-charcoal/70">{label}</dd>
                </div>
              ))}
            </dl>
            <div class="gs-reveal mt-10" data-reveal>
              <a
                href={mapsUrl}
                target="_blank"
                rel="noopener"
                class="group relative block overflow-hidden"
                aria-label={t.location.mapLink}
              >
                <Image
                  src={mapImage}
                  alt={t.location.mapLink}
                  widths={[480, 800, 1200, 1600]}
                  sizes="(max-width: 768px) 92vw, 50vw"
                  class="aspect-[16/10] w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.04]"
                />
                <span class="label absolute bottom-5 left-5 border border-gold/60 bg-ink/70 px-4 py-2.5 text-gold backdrop-blur-sm transition-colors duration-300 group-hover:bg-gold group-hover:text-ink">
                  {t.location.mapLink} ↗
                </span>
              </a>
              <p class="label mt-3 text-right text-[0.6rem] text-charcoal/40">© OpenStreetMap · © CARTO</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Contact: mailto form -->
    <section id="contact" class="bg-cream-deep px-5 py-24 sm:px-8 md:py-36">
      <div class="mx-auto grid max-w-7xl gap-14 md:grid-cols-12">
        <div class="gs-reveal md:col-span-5" data-reveal>
          <p class="label text-rose-deep">{t.contact.kicker}</p>
          <span class="rule my-6"></span>
          <h2 class="font-display text-4xl font-medium leading-[1.05] md:text-6xl">{t.contact.title}</h2>
          <p class="mt-8 max-w-md text-lg leading-relaxed text-charcoal/80">{t.contact.body}</p>
          <p class="label mt-10 text-charcoal/60">
            {t.contact.emailLabel}
            <a href={`mailto:${contactEmail}`} class="ml-2 text-rose-deep underline decoration-rose-deep/40 underline-offset-4 hover:decoration-rose-deep">{contactEmail}</a>
          </p>
        </div>
        <form class="gs-reveal md:col-span-7" data-reveal data-contact-form data-email={contactEmail}>
          <div class="grid gap-6 sm:grid-cols-2">
            <label class="block">
              <span class="label text-charcoal/60">{t.contact.name}</span>
              <input name="name" type="text" required class="mt-2 w-full border-b border-charcoal/30 bg-transparent py-3 outline-none transition-colors focus:border-rose-deep" />
            </label>
            <label class="block">
              <span class="label text-charcoal/60">{t.contact.dates}</span>
              <input name="dates" type="text" class="mt-2 w-full border-b border-charcoal/30 bg-transparent py-3 outline-none transition-colors focus:border-rose-deep" />
            </label>
            <label class="block sm:col-span-2">
              <span class="label text-charcoal/60">{t.contact.apartment}</span>
              <select name="apartment" class="mt-2 w-full border-b border-charcoal/30 bg-transparent py-3 outline-none transition-colors focus:border-rose-deep">
                <option value="">{t.contact.any}</option>
                <option value="Amore">Amore · {t.apartments.amore.type}</option>
                <option value="More">More · {t.apartments.more.type}</option>
              </select>
            </label>
            <label class="block sm:col-span-2">
              <span class="label text-charcoal/60">{t.contact.message}</span>
              <textarea name="message" rows="4" required class="mt-2 w-full resize-y border-b border-charcoal/30 bg-transparent py-3 outline-none transition-colors focus:border-rose-deep"></textarea>
            </label>
          </div>
          <button type="submit" class="label mt-10 border border-charcoal px-7 py-3.5 text-charcoal transition-colors duration-300 hover:bg-ink hover:border-ink hover:text-gold">
            {t.contact.send}
          </button>
          <p class="mt-4 text-sm text-charcoal/55">{t.contact.hint}</p>
        </form>
      </div>
    </section>

    <!-- Booking band -->
    <section class="relative overflow-hidden bg-ink px-5 py-28 text-center text-cream sm:px-8 md:py-36">
      <Motif kind="wave" class="pointer-events-none absolute -left-8 top-10 h-24 w-auto text-gold/10" />
      <Motif kind="heart" class="pointer-events-none absolute -right-6 bottom-8 h-28 w-auto text-gold/10" />
      <div class="gs-reveal relative mx-auto max-w-2xl" data-reveal>
        <h2 class="font-display text-5xl font-medium italic leading-tight text-gold md:text-6xl">{t.book.title}</h2>
        <p class="mt-6 text-lg text-cream/75">{t.book.body}</p>
        <a
          href="#contact"
          class="label mt-12 inline-block border border-gold px-9 py-4 text-gold transition-colors duration-300 hover:bg-gold hover:text-ink"
        >{t.book.cta}</a>
        <p class="label mt-8 text-cream/45">
          {t.book.alt}
          <a
            href={bookingUrls[locale]}
            target="_blank"
            rel="noopener"
            class="text-cream/70 underline decoration-cream/30 underline-offset-4 transition-colors hover:text-gold hover:decoration-gold"
          >Booking.com</a>
        </p>
      </div>
    </section>
  </main>
</Base>

<script>
  import { initContactForm } from '../scripts/contact-form';
  initContactForm();
</script>
