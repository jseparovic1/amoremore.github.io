---
import Base from '../layouts/Base.astro';
import Motif from './Motif.astro';
import { useTranslations, localePath, type Locale } from '../i18n/translations';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

type RecKey = keyof typeof t.recs.items;
interface Rec {
  key: RecKey;
  /** Google Maps search query, locale-independent */
  query: string;
}

const eat: Rec[] = [
  { key: 'ciba', query: 'Bistro Ćiba Split' },
  { key: 'planb', query: 'Plan B Pub Split' },
  { key: 'varos', query: 'Konoba Varoš Split' },
  { key: 'bokeria', query: 'Bokeria Kitchen & Wine Bar Split' },
];

const doSee: Rec[] = [
  { key: 'riva', query: 'Riva Split' },
  { key: 'palace', query: "Diocletian's Palace Split" },
  { key: 'marjan', query: 'Marjan Split' },
  { key: 'bacvice', query: 'Bačvice beach Split' },
  { key: 'znjan', query: 'Žnjan beach Split' },
  { key: 'boat', query: 'Split ferry port' },
];

const mapsSearch = (query: string) =>
  `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(query)}`;
---

<Base locale={locale} path="/recommendations" title={t.recs.metaTitle} description={t.recs.metaDescription}>
  <main>
    <!-- Page header -->
    <section class="bg-ink px-5 pb-20 pt-40 text-cream sm:px-8 md:pb-24 md:pt-48">
      <div class="mx-auto max-w-7xl">
        <p class="label text-gold" data-hero-item>{t.recs.kicker}</p>
        <h1 class="mt-6 max-w-3xl font-display text-5xl font-medium italic leading-[1.05] md:text-7xl" data-hero-item>
          {t.recs.title}
        </h1>
        <p class="mt-8 max-w-xl text-lg leading-relaxed text-cream/70" data-hero-item>{t.recs.intro}</p>
      </div>
    </section>

    <!-- Eat & drink -->
    <section class="px-5 py-20 sm:px-8 md:py-28">
      <div class="mx-auto max-w-7xl">
        <div class="gs-reveal flex items-end justify-between gap-6" data-reveal>
          <div>
            <p class="label text-rose-deep">{t.recs.eatTitle}</p>
            <span class="rule my-6"></span>
          </div>
          <Motif kind="heart" class="mb-2 hidden h-10 w-auto text-rose-deep/50 md:block" />
        </div>
        <ul class="mt-6 grid gap-x-14 md:grid-cols-2">
          {eat.map(({ key, query }) => (
            <li class="gs-reveal border-t border-charcoal/15 py-9" data-reveal>
              <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
                <h2 class="font-display text-2xl font-medium md:text-3xl">{t.recs.items[key].name}</h2>
                <span class="label text-rose-deep">{t.recs.items[key].tag}</span>
              </div>
              <p class="mt-4 leading-relaxed text-charcoal/80">{t.recs.items[key].blurb}</p>
              <a
                href={mapsSearch(query)}
                target="_blank"
                rel="noopener"
                class="label mt-5 inline-block text-charcoal/50 transition-colors hover:text-rose-deep"
              >{t.location.mapLink} →</a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Do & see -->
    <section class="bg-cream-deep px-5 py-20 sm:px-8 md:py-28">
      <div class="mx-auto max-w-7xl">
        <div class="gs-reveal flex items-end justify-between gap-6" data-reveal>
          <div>
            <p class="label text-rose-deep">{t.recs.doTitle}</p>
            <span class="rule my-6"></span>
          </div>
          <Motif kind="wave" class="mb-2 hidden h-10 w-auto text-rose-deep/50 md:block" />
        </div>
        <ul class="mt-6 grid gap-x-14 md:grid-cols-2">
          {doSee.map(({ key, query }) => (
            <li class="gs-reveal border-t border-charcoal/15 py-9" data-reveal>
              <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
                <h2 class="font-display text-2xl font-medium md:text-3xl">{t.recs.items[key].name}</h2>
                <span class="label text-rose-deep">{t.recs.items[key].tag}</span>
              </div>
              <p class="mt-4 leading-relaxed text-charcoal/80">{t.recs.items[key].blurb}</p>
              <a
                href={mapsSearch(query)}
                target="_blank"
                rel="noopener"
                class="label mt-5 inline-block text-charcoal/50 transition-colors hover:text-rose-deep"
              >{t.location.mapLink} →</a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Book CTA -->
    <section class="bg-ink px-5 py-24 text-center text-cream sm:px-8">
      <div class="gs-reveal mx-auto max-w-2xl" data-reveal>
        <p class="font-display text-3xl font-medium italic md:text-4xl">{t.book.title}</p>
        <a
          href={`${localePath(locale)}#contact`}
          class="label mt-10 inline-block border border-gold px-7 py-3.5 text-gold transition-colors duration-300 hover:bg-gold hover:text-ink"
        >{t.book.cta}</a>
      </div>
    </section>
  </main>
</Base>
