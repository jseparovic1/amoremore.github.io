---
import '../styles/global.css';
import logoWordmark from '../assets/brand/logo-full.svg';
import logoMark from '../assets/brand/logo-mark.svg';
import {
  locales,
  localePath,
  withBase,
  useTranslations,
  contactEmail,
  bookingUrls,
  type Locale,
} from '../i18n/translations';
import boskaUrl from '../assets/fonts/Boska-Variable.woff2?url';
import satoshiUrl from '../assets/fonts/Satoshi-Variable.woff2?url';

interface Props {
  locale: Locale;
  /** locale-independent path of the current page, e.g. '/' or '/amore/' */
  path: string;
  title?: string;
  description?: string;
  /** keep the page out of search engines (e.g. the guest portal) */
  noindex?: boolean;
}

const { locale, path, title, description, noindex = false } = Astro.props;
const t = useTranslations(locale);
const pageTitle = title ?? t.meta.title;
const pageDescription = description ?? t.meta.description;
const home = localePath(locale);

const ogLocales: Record<Locale, string> = { en: 'en_GB', hr: 'hr_HR', de: 'de_DE' };
const canonicalUrl = new URL(localePath(locale, path), Astro.site);
const ogImageUrl = new URL(withBase('/og-image.jpg'), Astro.site);

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'LodgingBusiness',
  name: 'AmoreMore Apartments',
  description: t.meta.description,
  url: new URL(localePath(locale), Astro.site).href,
  image: ogImageUrl.href,
  email: contactEmail,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Split',
    addressCountry: 'HR',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 43.505616,
    longitude: 16.450061,
  },
  sameAs: [bookingUrls[locale]],
  containsPlace: (['amore', 'more'] as const).map((id) => ({
    '@type': 'Accommodation',
    name: t.apartments[id].name,
    additionalType: t.apartments[id].type,
    description: t.apartments[id].blurb,
    url: new URL(localePath(locale, `/${id}/`), Astro.site).href,
    occupancy: { '@type': 'QuantitativeValue', maxValue: 2 },
  })),
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="theme-color" content="#090a0e" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph (Facebook, WhatsApp, LinkedIn, iMessage, Telegram, Viber) -->
    <meta property="og:site_name" content="AmoreMore Apartments" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.meta.ogImageAlt} />
    <meta property="og:locale" content={ogLocales[locale]} />
    {locales
      .filter((l) => l !== locale)
      .map((l) => <meta property="og:locale:alternate" content={ogLocales[l]} />)}

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={t.meta.ogImageAlt} />

    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="canonical" href={canonicalUrl} />
    {locales.map((l) => (
      <link rel="alternate" hreflang={l} href={new URL(localePath(l, path), Astro.site)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL(localePath('en', path), Astro.site)} />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <link rel="preload" href={boskaUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={satoshiUrl} as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <header class="fixed inset-x-0 top-0 z-40 transition-colors duration-500" id="site-header">
      <nav class="mx-auto flex max-w-7xl items-center justify-between px-5 py-4 sm:px-8">
        <a href={home} aria-label="AmoreMore Apartments" class="shrink-0">
          <img src={logoWordmark.src} alt="Amore More" class="h-9 w-auto sm:h-10" />
        </a>
        <div class="hidden items-center gap-8 md:flex">
          <a class="label text-cream/80 transition-colors hover:text-gold" href={`${home}#apartments`}>{t.nav.amore} &amp; {t.nav.more}</a>
          <a class="label text-cream/80 transition-colors hover:text-gold" href={`${home}#location`}>{t.nav.location}</a>
          <a class="label text-cream/80 transition-colors hover:text-gold" href={localePath(locale, '/recommendations/')}>{t.nav.tips}</a>
          <a
            class="label border border-gold/60 px-4 py-2 text-gold transition-colors hover:bg-gold hover:text-ink"
            href={`${home}#contact`}
          >{t.nav.book}</a>
        </div>
        <div class="flex items-center gap-3 md:ml-8">
          {locales.map((l) => (
            <a
              href={localePath(l, path)}
              class:list={[
                'label transition-colors',
                l === locale ? 'text-gold' : 'text-cream/50 hover:text-cream',
              ]}
              aria-current={l === locale ? 'page' : undefined}
            >{l}</a>
          ))}
        </div>
      </nav>
    </header>

    <slot />

    <footer class="bg-ink px-5 py-14 text-cream/60 sm:px-8">
      <div class="mx-auto flex max-w-7xl flex-col items-center gap-8 text-center">
        <img src={logoMark.src} alt="Amore More" class="h-20 w-auto opacity-90" />
        <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-3">
          <a class="label transition-colors hover:text-gold" href={`${home}#apartments`}>{t.nav.amore} &amp; {t.nav.more}</a>
          <a class="label transition-colors hover:text-gold" href={`${home}#location`}>{t.nav.location}</a>
          <a class="label transition-colors hover:text-gold" href={localePath(locale, '/recommendations/')}>{t.nav.tips}</a>
          <a class="label transition-colors hover:text-gold" href={localePath(locale, '/guest/')}>{t.nav.guest}</a>
          <a class="label transition-colors hover:text-gold" href={`mailto:${contactEmail}`}>{contactEmail}</a>
        </div>
        <p class="label text-cream/35">© {new Date().getFullYear()} {t.footer.rights}</p>
      </div>
    </footer>

    <script>
      import '../scripts/animations';
    </script>
  </body>
</html>
